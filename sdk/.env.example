# ==============================================================================
# Harness SDK HTTP Server Environment Configuration Example
# ==============================================================================

# Server Network Binds
PORT=3000
HOST=0.0.0.0

# Allowed Workspaces (Comma-separated base paths allowed for execution)
ALLOWED_WORKSPACES=/workspaces/backend,/workspaces/frontend,/workspaces/payment-service

# ------------------------------------------------------------------------------
# Project Registry Mappings (Client passes `"project": "backend"`)
# ------------------------------------------------------------------------------

# Option 1: JSON-formatted Project Mappings
PROJECT_MAPPINGS={"backend":{"path":"/workspaces/backend","gitUrl":"https://github.com/my-org/backend.git"},"frontend":{"path":"/workspaces/frontend","gitUrl":"https://github.com/my-org/frontend.git"}}

# Option 2: Prefixed Environment Variables (Alternative)
# PROJECT_BACKEND_PATH=/workspaces/backend
# PROJECT_BACKEND_GIT_URL=https://github.com/my-org/backend.git
# PROJECT_FRONTEND_PATH=/workspaces/frontend
# PROJECT_FRONTEND_GIT_URL=https://github.com/my-org/frontend.git
