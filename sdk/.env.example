# ==============================================================================
# Harness SDK HTTP Server Environment Configuration Example
# ==============================================================================

# Server Network Binds
PORT=3000
HOST=0.0.0.0

# Allowed Workspaces (Comma-separated base paths allowed for execution)
ALLOWED_WORKSPACES=/workspaces/backend,/workspaces/frontend,/workspaces/payment-service

# ------------------------------------------------------------------------------
# Project Registry Mappings (Client passes `"project": "backend"`)
# ------------------------------------------------------------------------------

# Option 1: JSON-formatted Project Mappings
PROJECT_MAPPINGS={"backend":{"path":"/workspaces/backend","gitUrl":"https://github.com/my-org/backend.git","baseBranch":"develop"},"frontend":{"path":"/workspaces/frontend","gitUrl":"https://github.com/my-org/frontend.git","baseBranch":"main"}}

# Option 2: Prefixed Environment Variables (Alternative)
# PROJECT_BACKEND_PATH=/workspaces/backend
# PROJECT_BACKEND_GIT_URL=https://github.com/my-org/backend.git
# PROJECT_BACKEND_BASE_BRANCH=develop
# PROJECT_FRONTEND_PATH=/workspaces/frontend
# PROJECT_FRONTEND_GIT_URL=https://github.com/my-org/frontend.git
# PROJECT_FRONTEND_BASE_BRANCH=main

# ------------------------------------------------------------------------------
# Git Credentials & Automated Commit Configuration
# ------------------------------------------------------------------------------
# GIT_COMMIT_AUTHOR_NAME="HRNS Bot"
# GIT_COMMIT_AUTHOR_EMAIL="bot@company.com"
# GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GIT_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# Security & Authentication Options
# ------------------------------------------------------------------------------
# AUTH_MODE options: "none" (default/disabled), "basic", "bearer", "jwt", or "hmac"

# Mode A: Bearer Token / API Key (Recommended for CI/CD & M2M)
# AUTH_MODE=bearer
# AUTH_BEARER_TOKEN=hrns_sk_live_9876543210

# Mode B: HTTP Basic Auth
# AUTH_MODE=basic
# AUTH_BASIC_USER=admin
# AUTH_BASIC_PASS=senha_super_segura_123

# Mode C: JWT / OpenID Connect (OIDC) (Recommended for Multi-tenant & RBAC)
# AUTH_MODE=jwt
# AUTH_JWT_SECRET=sua_chave_secreta_jwt_min_256_bits
# AUTH_JWT_ISSUER=https://auth.empresa.com/
# AUTH_JWT_AUDIENCE=hrns-api

# Mode D: HMAC SHA-256 (Recommended for Webhook Event Verification)
# AUTH_MODE=hmac
# AUTH_HMAC_SECRET=sua_chave_secreta_hmac_webhook

# Mode E: Disabled (Default for local development)
AUTH_MODE=none
